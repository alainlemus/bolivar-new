# syntax=docker/dockerfile:1.7
# Producción (Dokploy): rama principal, dominio garciadebolivar.com / .com.mx
# Etapas: vendor (Composer sin dev) -> assets (Vite) -> runtime (PHP 8.4 + Nginx, usuario no-root, puerto 8080)

FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --ignore-platform-reqs
COPY . .
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev --no-scripts --ignore-platform-reqs

FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Tailwind escanea las vistas del framework (paginación) dentro de vendor/
COPY --from=vendor /app/vendor ./vendor
RUN npm run build

FROM serversideup/php:8.4-fpm-nginx AS runtime

USER root
RUN install-php-extensions intl exif gd zip bcmath pdo_mysql

ENV APP_ENV=production \
    APP_DEBUG=false \
    PHP_OPCACHE_ENABLE=1 \
    PHP_MEMORY_LIMIT=256M \
    PHP_UPLOAD_MAX_FILE_SIZE=20M \
    PHP_POST_MAX_SIZE=25M \
    SSL_MODE=off \
    AUTORUN_ENABLED=true \
    AUTORUN_LARAVEL_MIGRATION=true \
    AUTORUN_LARAVEL_MIGRATION_ISOLATION=true \
    AUTORUN_LARAVEL_STORAGE_LINK=true \
    AUTORUN_LARAVEL_OPTIMIZE=true

WORKDIR /var/www/html
COPY --chown=www-data:www-data . .
COPY --chown=www-data:www-data --from=vendor /app/vendor ./vendor
COPY --chown=www-data:www-data --from=assets /app/public/build ./public/build

USER www-data
RUN php artisan package:discover --ansi

# Las subidas del panel viven en storage/app/public: monta un volumen persistente aquí
VOLUME ["/var/www/html/storage/app/public"]
EXPOSE 8080
