# syntax=docker/dockerfile:1.7
# Desarrollo / staging (Dokploy): rama dev, dominio de pruebas (p. ej. dev.garciadebolivar.com)
# Igual que prod pero con dependencias de desarrollo, sin cachés de config/rutas y con depuración activable.

FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-scripts --no-autoloader --prefer-dist --no-interaction --ignore-platform-reqs
COPY . .
RUN composer dump-autoload --optimize --no-scripts --ignore-platform-reqs

FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
COPY --from=vendor /app/vendor ./vendor
RUN npm run build

FROM serversideup/php:8.4-fpm-nginx AS runtime

USER root
RUN install-php-extensions intl exif gd zip bcmath pdo_mysql

ENV APP_ENV=staging \
    PHP_OPCACHE_ENABLE=0 \
    PHP_MEMORY_LIMIT=512M \
    PHP_UPLOAD_MAX_FILE_SIZE=20M \
    PHP_POST_MAX_SIZE=25M \
    SSL_MODE=off \
    AUTORUN_ENABLED=true \
    AUTORUN_LARAVEL_MIGRATION=true \
    AUTORUN_LARAVEL_MIGRATION_ISOLATION=true \
    AUTORUN_LARAVEL_STORAGE_LINK=true \
    AUTORUN_LARAVEL_OPTIMIZE=false

WORKDIR /var/www/html
COPY --chown=www-data:www-data . .
COPY --chown=www-data:www-data --from=vendor /app/vendor ./vendor
COPY --chown=www-data:www-data --from=assets /app/public/build ./public/build

USER www-data
RUN php artisan package:discover --ansi

VOLUME ["/var/www/html/storage/app/public"]
EXPOSE 8080
